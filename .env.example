# Thakeen (code name Nashr): environment variable NAMES only (rule 1977).
# The list, what each one does and where it is read: docs/system/variables.md. Copy to .env.local for `next dev` and fill
# in only what you need; without Redis credentials outside production the app uses its in-memory store, and without
# RESEND_API_KEY mail goes to the console provider (src/lib/mail-provider.ts). Never commit a value here or anywhere.
# A commented name is set by the platform or the build, or read by a release script, not by you in .env.local.

# --- 1. Core platform
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ANTHROPIC_API_KEY=
LLM_PROVIDER=
STRAITLY_API_KEY=
STRAITLY_BASE_URL=
APP_ORIGIN=
# NODE_ENV=
# VERCEL_ENV=
# VERCEL=
TRUSTED_PROXY_HOPS=
APP_ENV=
# The end-to-end server's starting records (playwright.config.ts sets it; never on a host). docs/system/variables.md.
E2E_SEED_KV=
# BUILD_COMMIT=
# BUILD_TIME=

# --- 2. Access control
ADMIN_EMAILS=
WAITLIST_ADMIN_KEY=
