# Supply-chain gate (rule 699, founder decision 2026-10-08): never resolve a package version published less than
# 7 days ago, so a hijacked release is usually caught and pulled before it reaches us. Needs npm 11.10 or later;
# older npm warns "Unknown project config" and ignores it. `npm ci` installs the lockfile as it is either way.
min-release-age=7
